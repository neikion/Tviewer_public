<UserControl x:Class="Tviewer.view.Modal.SimpleInputModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Tviewer.view.Modal"
             xmlns:controller="clr-namespace:Tviewer.view.Modal"
             d:DataContext="{d:DesignInstance local:SimpleModalController}"
             Background="{StaticResource ConfigWindowBackGround}"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
            <RowDefinition Height="35" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0"
              VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding Message}" Grid.Row="0" />
            <TextBox Margin="0,5,0,0"
                     Grid.Row="1"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap"
                     Text="{Binding Content, Mode=OneWayToSource, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Grid.Row="2">
            <Button Margin="20,0,0,0"
                    Width="70"
                    x:Name="AcceptButton"
                    Content="{Binding AcceptText}"
                    Command="{Binding AcceptCommand}"
                    IsTabStop="True"
                    IsDefault="True" />
            <Button Margin="20,0,0,0"
                    Width="70"
                    IsCancel="True"
                    IsTabStop="True"
                    Content="{Binding CancleText}"
                    Visibility="{Binding CancelVisibility}" />
        </StackPanel>
    </Grid>
</UserControl>

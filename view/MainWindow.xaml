<Window x:Class="Tviewer.view.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tviewer.controller"
        xmlns:TitleBar="clr-namespace:Tviewer.view.TitleBar"
        xmlns:maxiconv="clr-namespace:Tviewer.Converter"
        xmlns:extension="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:slidingPanel="clr-namespace:Tviewer.view.SlidingPanel"
        xmlns:view="clr-namespace:Tviewer.view"
        d:DataContext="{d:DesignInstance Type=local:MainWindowControlloer}"
        mc:Ignorable="d"
        WindowState="{Binding WinState}"
        WindowStyle="{Binding WinStyle}"
        ResizeMode="{Binding WinResizeMode}"
        SizeChanged="OnSizeChanged"
        IsTabStop="False"
        Width="800"
        Height="450"
        IsHitTestVisible="True">

    <extension:Interaction.Triggers>
        <extension:EventTrigger EventName="KeyDown">
            <extension:InvokeCommandAction Command="{Binding KeyDown}"
                                           PassEventArgsToCommand="True" />
        </extension:EventTrigger>
        <extension:EventTrigger EventName="PreviewKeyDown">
            <extension:InvokeCommandAction Command="{Binding PreviewKeyDown}"
                                           PassEventArgsToCommand="True" />
        </extension:EventTrigger>
    </extension:Interaction.Triggers>
    
    <Window.Resources>
        <Style TargetType="{x:Type Control}" x:Key="baseStyle">
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource baseStyle}"/>
        <Style TargetType="{x:Type Label}" BasedOn="{StaticResource baseStyle}"/>
        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource baseStyle}"/>
        <Style TargetType="{x:Type ListView}" BasedOn="{StaticResource baseStyle}"/>
        <maxiconv:MaximizeConverterForGrid x:Key="MaximizeConvGrid"/>
        <maxiconv:MaximizeConveterVisibility x:Key="MaximizeConvVisibility"/>
        <maxiconv:MaximaizeConverterForGlassFrame x:Key="MaxiConvGlassFrame" />
        <maxiconv:BorderThicknessMaximaizeConverter x:Key="MaxiConvResizeThickness" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibleConverter" />
    </Window.Resources>


    <WindowChrome.WindowChrome>
        <WindowChrome 
            CornerRadius="0"
            CaptionHeight="0"
            NonClientFrameEdges="None"
            ResizeBorderThickness="{Binding RelativeSource={RelativeSource AncestorType=Window},Path=WindowState,Converter={StaticResource MaxiConvResizeThickness},ConverterParameter='10',Mode=OneWay}"
            GlassFrameThickness="{Binding RelativeSource={RelativeSource AncestorType=Window},Path=WindowStyle,Converter={StaticResource MaxiConvGlassFrame},ConverterParameter='0.000001',Mode=OneWay}"
            >
        </WindowChrome>
    </WindowChrome.WindowChrome>

    <Grid Name="ContentGrid">
        <Grid.RowDefinitions>
            <!--converter parameter is to set grid height-->
            <RowDefinition Height="{Binding ElementName=TitleBar, Path=Visibility, Converter={StaticResource MaximizeConvGrid}, ConverterParameter='30', Mode=OneWay}"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TitleBar:TitleBarControl Grid.Row="0"
                                  Title="{Binding GetProjectName}"
                                  CloseCommand="{Binding CloseBtn}"
                                  MinimizeCommand="{Binding MinimizeBtn}"
                                  MaximizeCommand="{Binding MaximizeBtn}"
                                  MouseDown="OnTitleDrag"
                                  Background="{StaticResource ContentListBackground}"
                                  DoubleClickCommand="{Binding MaximizeBtn}"
                                  x:Name="TitleBar"
                                  Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=WindowStyle, Converter={StaticResource MaximizeConvVisibility}, Mode=OneWay}"
                                  MenuCommand="{Binding ImageButtonDown}"
                                  />

        <DockPanel Grid.Row="1">
            <slidingPanel:SlidingPanel Background="Black"
                                       Width="220"
                                       DataContext="{Binding SlidingController}"
                                       DockPanel.Dock="Left"
                                       SlidingState="{Binding SlideState}"
                                        />

            <ContentControl Content="{Binding MainContent}"
                            Focusable="False"/>
        </DockPanel>
        
    </Grid>
</Window>
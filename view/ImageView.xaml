<UserControl x:Class="Tviewer.view.ImageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Tviewer.controller"
             xmlns:extension="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:conv="clr-namespace:Tviewer.Converter"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:ImageViewController}"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Focusable="True"
             IsTabStop="True"
             FocusVisualStyle="{x:Null}"
             Cursor="{Binding CursorVisible, Converter={StaticResource CursorConverter}}"
             Background="Black">

    <extension:Interaction.Triggers>
        <extension:EventTrigger EventName="KeyDown">
            <extension:InvokeCommandAction Command="{Binding KeyDown}"
                                           PassEventArgsToCommand="True" />
        </extension:EventTrigger>
    </extension:Interaction.Triggers>

    <UserControl.Resources>
        <conv:BoolToVisibleConverter x:Key="VisibleConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Image Grid.Row="0"
               Panel.ZIndex="0"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               RenderOptions.EdgeMode="Unspecified"
               SnapsToDevicePixels="True"
               StretchDirection="DownOnly"
               FocusVisualStyle="{x:Null}"
               RenderOptions.BitmapScalingMode="{Binding ScalingMode}"
               Source="{Binding ImageContent}"
               Stretch="{Binding StretchMode}" />
        <StackPanel Panel.ZIndex="1"
                    Orientation="Vertical"
                    Margin="30,80,0,0"
                    Width="250"
                    HorizontalAlignment="Left"
                    Visibility="{Binding InfoVisible, Converter={StaticResource VisibleConverter}}">
            <ItemsControl ItemsSource="{Binding Profile}"
                          Padding="5"
                          Cursor="Arrow"
                          Background="Black">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding }"
                                   Foreground="White"
                                   Background="Transparent"
                                   FontSize="{StaticResource ImageInfoFontSize}"
                                   TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>

</UserControl>

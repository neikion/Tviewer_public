<UserControl x:Class="Tviewer.view.SearchBar.SearchBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Tviewer.view.SearchBar"
             xmlns:conv="clr-namespace:Tviewer.Converter"
             mc:Ignorable="d"
             d:FontSize="24"
             d:DesignWidth="800">
    <UserControl.Resources>
        <conv:BoolOrTextToVisibleConverter x:Key="VisibleConverter" />
    </UserControl.Resources>
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                              Width="9*" />
            <ColumnDefinition
                              Width="20" />
            <ColumnDefinition
                              Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid
              ScrollViewer.HorizontalScrollBarVisibility="Auto"
              ScrollViewer.VerticalScrollBarVisibility="Auto"
              Background="White"
              Grid.Column="0"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <!--textblock의 VerticalAlignment설정 시 hint 위치 조정-->
            <TextBlock Padding="5,0,0,0"
                       Grid.Column="0"
                       Text="{Binding RelativeSource={RelativeSource AncestorType=local:SearchBar},Path=Hint}"
                       Foreground="LightSteelBlue"
                       VerticalAlignment="Center"
                       Height="{Binding ElementName=txtSearchBox,Path=ActualHeight}"
                       FontSize="{Binding ElementName=txtSearchBox, Path=FontSize}"
                       IsHitTestVisible="False">
                <TextBlock.Visibility>
                    <MultiBinding Converter="{StaticResource VisibleConverter}">
                        <Binding ElementName="txtSearchBox"
                                 Path="IsFocused" />
                        <Binding ElementName="txtSearchBox"
                                 Path="Text" />
                    </MultiBinding>
                </TextBlock.Visibility>
            </TextBlock>
            <TextBox Name="txtSearchBox"
                     Grid.Column="1"
                     VerticalAlignment="Stretch"
                     Text="{Binding RelativeSource={RelativeSource AncestorType=local:SearchBar},Path=Text, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                     IsReadOnly="{Binding RelativeSource={RelativeSource AncestorType=local:SearchBar},Path=IsReadOnly}"
                     IsTabStop="{Binding RelativeSource={RelativeSource AncestorType=local:SearchBar},Path=IsTextBoxTabStop}"
                     Background="Transparent"
                     GotFocus="OnFoucus"
                     LostFocus="OnLostFocus">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return"
                                Command="{Binding RelativeSource={RelativeSource AncestorType=local:SearchBar}, Path=ButtonCommand}"
                                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=local:SearchBar}, Path=Text}" />
                </TextBox.InputBindings>
            </TextBox>
        </Grid>

        <Button Grid.Column="2"
                IsTabStop="{Binding RelativeSource={RelativeSource AncestorType=local:SearchBar},Path=IsButtonTabStop}"
                Content="{Binding RelativeSource={RelativeSource AncestorType=local:SearchBar},Path=ButtonText}"
                Command="{Binding RelativeSource={RelativeSource AncestorType=local:SearchBar},Path=ButtonCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=local:SearchBar}, Path=Text}"
                />

    </Grid>

</UserControl>

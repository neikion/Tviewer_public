<UserControl x:Class="Tviewer.view.HierarchicalTree.HierarchicalTree"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Tviewer.view.HierarchicalTree"
             xmlns:treeItem="clr-namespace:Tviewer.model.HierarchicalTree"
             mc:Ignorable="d"
             Name="root"
             d:DesignHeight="450"
             d:DesignWidth="200">
    <TreeView ItemsSource="{Binding ElementName=root,Path=ItemSource}"
              Name="Tree"
              VirtualizingPanel.IsVirtualizing="True"
              VirtualizingPanel.VirtualizationMode="Recycling"
              SelectedItemChanged="OnSelectedItemChanged"
              Loaded="LoadedTreeView"
              BorderThickness="{Binding ElementName=root,Path=BorderThickness}">
        <TreeView.ItemTemplate>
            <HierarchicalDataTemplate DataType="{x:Type treeItem:HierarchicalTreeItem}"
                                      ItemsSource="{Binding Children}">
                <TextBlock Text="{Binding Name}" />
            </HierarchicalDataTemplate>
        </TreeView.ItemTemplate>
    </TreeView>
</UserControl>

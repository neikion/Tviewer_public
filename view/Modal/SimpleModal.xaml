<UserControl x:Class="Tviewer.view.Modal.SimpleModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Tviewer.view.Modal"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:SimpleModalController}"
             Background="{StaticResource ConfigWindowBackGround}"
             Loaded="OnLoaded"
             d:DesignHeight="450"
             d:DesignWidth="800">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="10" />
            <RowDefinition Height="35" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="ContentBlock"
                   TextAlignment="Center"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Text="{Binding Content}"
                   Focusable="False" />
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Grid.Row="2">
            <Button Margin="20,0,0,0"
                    Width="70"
                    x:Name="AcceptButton"
                    Content="{Binding AcceptText}"
                    Command="{Binding AcceptCommand}"
                    IsTabStop="True"
                    IsDefault="True" />
            <Button Margin="20,0,0,0"
                    Width="70"
                    IsCancel="True"
                    IsTabStop="True"
                    Content="{Binding CancleText}"
                    Visibility="{Binding CancelVisibility}" />
        </StackPanel>
    </Grid>

</UserControl>

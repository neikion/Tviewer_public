<Popup x:Class="Tviewer.view.Modal.CheckBoxModal"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
       xmlns:local="clr-namespace:Tviewer.view.Modal"
       xmlns:conv="clr-namespace:Tviewer.Converter"
       mc:Ignorable="d"
       Name="root"
       d:DesignHeight="450"
       d:DesignWidth="800"
       StaysOpen="False"
       Opened="OnOpened"
       PreviewKeyDown="OnPreviewKeyDown">
    <Popup.Resources>
        <conv:CheckBoxModalToEventArgsConverter x:Key="ToArgsConverter" />
    </Popup.Resources>
    <ListBox Name="list"
             ItemsSource="{Binding ElementName=root, Path=ItemsSource}">
        <ListBox.ItemTemplate>
            <DataTemplate>
                <CheckBox Content="{Binding Name}"
                          Command="{Binding RelativeSource={RelativeSource AncestorType=local:CheckBoxModal}, Path=ItemSelectedCommand}">
                    <CheckBox.CommandParameter>
                        <MultiBinding Converter="{StaticResource ToArgsConverter}">
                            <Binding RelativeSource="{RelativeSource Mode=Self}"
                                     Path="IsChecked" />
                            <Binding RelativeSource="{RelativeSource AncestorType=ListBoxItem}"
                                     Path="DataContext" />
                            <Binding RelativeSource="{RelativeSource AncestorType=local:CheckBoxModal}"
                                     Path="ItemSelectedCommandParameter" />
                        </MultiBinding>
                    </CheckBox.CommandParameter>
                </CheckBox>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</Popup>

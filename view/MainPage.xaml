<UserControl x:Class="Tviewer.view.MainPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Tviewer.controller"
             xmlns:SearchBar="clr-namespace:Tviewer.view.SearchBar"
             xmlns:listview="clr-namespace:Tviewer.view.ContentListView"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:MainPageController}"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Background="{StaticResource ContentListBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="5*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="1"
                    Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <SearchBar:SearchBar Width="400"
                                 Height="28"
                                 FontSize="16"
                                 Padding="0,0,20,0"
                                 Hint="검색"
                                 ButtonText="검색"
                                 IsButtonTabStop="False"
                                 Text="{Binding SearchText, Mode=TwoWay}"
                                 IsTextFocus="{Binding IsInputText, Mode=OneWayToSource}"
                                 ButtonCommand="{Binding SearchButtonDown}"
                                 />
        </StackPanel>

        <listview:ContentListView Grid.Column="1"
                                  Grid.Row="1"
                                  ItemClick="{Binding ListViewItemInputDown}"
                                  ContentList="{Binding ContentList}"
                                  SelectedIndex="{Binding SelectedIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  TagClickCommand="{Binding ListViewTagClick}"
                                  ScrollToBottom="{Binding ScrollToEnd}"
                                  OpenContentSettingCommand="{Binding OpenContentSetting}"
                                  CollectionChangedCommand="{Binding OnCollectionChanged}"
                                  CollectionSource="{Binding UserCollection}" >
        </listview:ContentListView>
    </Grid>
</UserControl>

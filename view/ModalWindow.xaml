<Window x:Class="Tviewer.view.ModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controller="clr-namespace:Tviewer.controller"
        xmlns:local="clr-namespace:Tviewer.view"
        mc:Ignorable="d"
        WindowStyle="{Binding WindowStyle}"
        ShowInTaskbar="{Binding ShowInTaskBar}"
        AllowsTransparency="{Binding AllowsTransparency}"
        Background="Transparent"
        FontSize="{StaticResource DefaultFontSize}"
        d:DataContext="{d:DesignInstance Type=controller:ModalWindowController}"
        local:ModalWindow.MyDialogResult="{Binding DialogResult}"
        local:ModalWindow.ModalAnimation="{Binding PlayingAnimation}"
        Loaded="OnLoaded"
        Unloaded="OnUnloaded"
        WindowStartupLocation="CenterOwner"
        ShowActivated="{Binding ShowActivated}"
        Topmost="{Binding TopMost}"
        MouseDown="OnMouseDown"
        Height="200"
        Width="400">
    <ContentControl Content="{Binding MainContent}"
                    IsTabStop="False" />
</Window>
